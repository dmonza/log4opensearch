# Defaults for the whole stack. This file IS committed on purpose — it holds no secrets.
# Machine-specific values go in docker-compose.override.yml. Never put a credential here:
# CI fails the build if it finds one.
#
# NOTE: verify the exact tags exist before pinning:
#   https://hub.docker.com/r/opensearchproject/opensearch/tags
#   https://hub.docker.com/r/opensearchproject/logstash-oss-with-opensearch-output-plugin/tags

# --- Image versions (never use :latest) ---
OPENSEARCH_VERSION=3.7.0
DASHBOARDS_VERSION=3.7.0
LOGSTASH_VERSION=8.9.0
# OpenTelemetry (OTLP) receiver — only used under `docker compose --profile otel up`.
DATAPREPPER_VERSION=2.16.0

# --- Resources ---
OPENSEARCH_HEAP=512m
LOGSTASH_HEAP=256m
# Heap for the OTLP receiver (opt-in profile only).
DATAPREPPER_HEAP=512m

# --- Published ports (host side) ---
OPENSEARCH_PORT=9200
DASHBOARDS_PORT=5601
LOG_UDP_PORT=5960
# OpenTelemetry OTLP/gRPC ports (opt-in profile only). Both speak gRPC — this stack ships
# no OTLP/HTTP, so 4318 carries logs over gRPC here (it is not the usual OTLP/HTTP port).
OTLP_TRACES_PORT=4317
OTLP_LOGS_PORT=4318

# --- Log retention (days) applied by the ISM policy ---
LOG_RETENTION_DAYS=30
